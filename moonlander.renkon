}

function fillRightInfoPanel(gameState, hudState, shipState, collisionState) {
  const {hudContext, hudWidth, hudHeight} = hudState;
  const {currentFuel, velocityX, velocityY, r} = shipState;
  const {altitude} = collisionState;
  const {
    infoPanelFontSize, infoPanelTextColor, 
    infoPanelRelativeOffsetX, infoPanelRelativeOffsetY, infoPanelRelativeOffsetYStep
  } = viewConstants;

  hudContext.textAlign = 'right';
  hudContext.fillStyle = infoPanelTextColor;
  hudContext.font = "Normal "+infoPanelFontSize+"px Courier New";
  hudContext.fillText(
    "ALTITUDE".padEnd(20, " ") + altitude.toFixed(0).padStart(4, "0"), 
    hudWidth*(1-infoPanelRelativeOffsetX), 
    hudHeight*(infoPanelRelativeOffsetY+0*infoPanelRelativeOffsetYStep));
  hudContext.fillText(
    "HORIZONTAL SPEED".padEnd(18, " ") + velocityX.toFixed(1).padStart(6, " "), 
    hudWidth*(1-infoPanelRelativeOffsetX), 
    hudHeight*(infoPanelRelativeOffsetY+1*infoPanelRelativeOffsetYStep));
  hudContext.fillText(
    "VERTICAL SPEED".padEnd(18, " ") + (-velocityY).toFixed(1).padStart(6, " "), 
    hudWidth*(1-infoPanelRelativeOffsetX), 
    hudHeight*(infoPanelRelativeOffsetY+2*infoPanelRelativeOffsetYStep));
  hudContext.fillText(
    "ROTATION ANGLE".padEnd(18, " ") + (-r * (180/Math.PI)).toFixed(1).padStart(6, " "), 
    hudWidth*(1-infoPanelRelativeOffsetX), 
    hudHeight*(infoPanelRelativeOffsetY+3*infoPanelRelativeOffsetYStep));
  hudContext.fillText(
    "FUEL".padEnd(20, " ") + currentFuel.toFixed(0).padStart(4, "0"), 
    hudWidth*(1-infoPanelRelativeOffsetX),
    hudHeight*(infoPanelRelativeOffsetY+4*infoPanelRelativeOffsetYStep));
}

function fillMainPanel(gameState, hudState, shipState, collisionState, timerState) {
  const {state, scoreChange, since, winner, winnerName, survivors} = gameState;
  const {currentFuel} = shipState;
  const {hudContext, hudWidth, hudHeight} = hudState;
  const {landed, crashInfo, fuelChange} = collisionState;
  const {
    mainPanelFontSize, mainPanelTextColor, 
    statsPanelFontSize, statsPanelTextColor,
    statsPanelRelativeOffsetX, statsPanelRelativeOffsetY, statsPanelRelativeOffsetYStep,
    mainPanelRelativeOffsetX, mainPanelRelativeOffsetY, mainPanelRelativeOffsetYStep} = viewConstants;

  hudContext.textAlign = 'center';

  if(state === "isBetweenRounds") {
    hudContext.font = "Normal "+mainPanelFontSize+"px Courier New";
    hudContext.fillStyle = mainPanelTextColor;
    const whole = Math.ceil(3 - (timerState.now - since) / 1000);
    const frac = 3 - (timerState.now - since) / 1000;
    hudContext.fillText(
      "YOU ARE PLAYER: " + players.map.get(viewId).color.toUpperCase(), 
      hudWidth*mainPanelRelativeOffsetX, 
      hudHeight*(mainPanelRelativeOffsetY+0*mainPanelRelativeOffsetYStep));
    hudContext.fillText(
      "ARROW KEYS / ON-SCREEN CONTROLS",
      hudWidth*mainPanelRelativeOffsetX,
      hudHeight*(mainPanelRelativeOffsetY+1*mainPanelRelativeOffsetYStep));
    hudContext.font = "Normal "+(mainPanelFontSize * (1 + frac))+"px Courier New";
    hudContext.fillStyle = mainPanelTextColor;
    hudContext.fillText(
      \`\${whole}\`,
      hudWidth*mainPanelRelativeOffsetX,
      hudHeight*(mainPanelRelativeOffsetY+1*mainPanelRelativeOffsetYStep));
    return;
  }

  let landingText, scoreText, fuelText, gameOverText;
  if (state === "showWinner") {
    hudContext.font = "Normal "+statsPanelFontSize+"px Courier New";
    hudContext.fillStyle = statsPanelTextColor;

    gameOverText = "";
    if (winner === "NOBODY") {
      landingText = "NO WINNER";
      scoreText = crashInfo;
    } else {
      landingText = "WINNER: PLAYER " + winnerName.toUpperCase();
      scoreText = "";
    }
  } else if (state === "playOn" && survivors && !survivors.has(viewId)) {
    landingText = "LANDER DESTROYED";
    scoreText = crashInfo;
  } else {
    // console.log("you are still there");
    return;
  }

  hudContext.fillText(
    landingText, 
    hudWidth*statsPanelRelativeOffsetX, 
    hudHeight*(statsPanelRelativeOffsetY+0*statsPanelRelativeOffsetYStep));
  hudContext.fillText(
    scoreText, 
    hudWidth*statsPanelRelativeOffsetX, 
    hudHeight*(statsPanelRelativeOffsetY+1*statsPanelRelativeOffsetYStep));
  hudContext.fillText(
    gameOverText, 
    hudWidth*statsPanelRelativeOffsetX, 
    hudHeight*(statsPanelRelativeOffsetY+3*statsPanelRelativeOffsetYStep));        
}
`],
[`34`, `const timerState = Behaviors.select(
  {now: 0 , delta: 0.01},
  timer, (prev, timer) => ({now: Renkon.time, delta: (Renkon.time - prev.now) / 1000.0})
);

const timer = Events.timer(1000/60);
`],
[`42`, `const somebodyLanded = Events.receiver();
const somebodyCrashed = Events.receiver();
const newRound = Events.receiver();

const gameState = Behaviors.select(
  {isDebugOn: false, state: "isBetweenRounds", since: 0, winner: "", knownPlayers: new Set(), survivors: new Set()},
  players, (prev, players) => {
    const prevKeys = [...prev.knownPlayers];
    const newKeys = [...players.map.keys()];
    const olds = prevKeys.filter((e) => !newKeys.includes(e));
    const news = newKeys.filter((e) => !prevKeys.includes(e));
    olds.forEach((id) => {
      prev.knownPlayers.delete(id);
      prev.survivors.delete(id);
    });
    if (prev.state === "inBetweenRounds") {
      news.forEach((id) => {
        prev.knownPlayers.add(id);
      });
    } else if (prev.state === "playOn") {
     news.forEach((id) => {
       prev.knownPlayers.add(id);
       prev.survivors.add(id);
      });
    }
    return {...prev};
  },
  somebodyLanded, (prev, somebodyLanded) => {
    return {...prev, state: "showWinner", survivors: new Set([somebodyLanded.winner]), since: Renkon.time, winner: somebodyLanded.winner, winnerName: somebodyLanded.winnerName};
  },
  somebodyCrashed, (prev, somebodyCrashed) => {
    const sorted = [...somebodyCrashed.collisionStateMap].sort((a, b) => b.time - a.time);
    const survivors = somebodyCrashed.survivors;
    console.log("somebodyCrashed", somebodyCrashed, survivors);
    if (survivors.size === 0) {
      return {...prev, state: "showWinner", since: Renkon.time, winner: "NOBODY", survivors};
    }
    return {...prev, prevState: "playOn", state: "playOn", survivors};
  },
  timerState, (prev, timerState) => {
    if (prev.state === "isBetweenRounds") {
      if (timerState.now - prev.since > 3000) {
        return {...prev, prevState: prev.state, state: "playOn", knownPlayers: new Set([...players.map.keys()]), survivors: new Set([...players.map.keys()]), since: timerState.now};
      }
    }
    if (prev.state === "showWinner") {
      if (timerState.now - prev.since > 3000) {
        Events.send(newRound, true);
        return {...prev, state: "isBetweenRounds", survivors: new Set(), since: timerState.now};
      }
    }
    return prev;
  }
);

const newCollisionState = (viewId) => {
  return {viewId, landed: false, crashInfo: "", altitude: 300, time: 0}
};

// model
const collisionState = Behaviors.select(
  (() => {
    const newCollisionState = (viewId) => {
      return {viewId, landed: false, crashInfo: "", altitude: 300, fuelChange: 0, time: 0}
    };
    return {map: new Map([...shipStates.map.keys()].map((id) => {
      return [id, newCollisionState(id)];
    }))};
  })(),
  players, (prev, players) => {
    const newCollisionState = (viewId) => {
      return {viewId, landed: false, crashInfo: "", altitude: 300, fuelChange: 0, time: 0}
    };
    let changed = false;
    const prevKeys = [...prev.map.keys()];
    const newKeys = [...players.map.keys()];
    const olds = prevKeys.filter((e) => !newKeys.includes(e));
    const news = newKeys.filter((e) => !prevKeys.includes(e));
    olds.forEach((viewId) => {
      changed = true;
      prev.map.delete(viewId)
    });
    news.forEach((viewId) => {
      changed = true;
      prev.map.set(viewId, newCollisionState(viewId));
    });
    return changed ? {map: prev.map} : prev;
  },
  newRound, (prev, _newRound) => {
    console.log("newRound collisionState");
    const newCollisionState = (viewId) => {
      return {viewId, landed: false, crashInfo: "", altitude: 300, fuelChange: 0, time: 0}
    };
    const newMap = new Map([...prev.map].map(([viewId, _v]) => {
      return [viewId, newCollisionState(viewId)];
    }));
    return {map: newMap};
  },
  shipStates, (prev, shipStates) => {
    // orderCheck
    const lineSegments = lineSegmentsModel;
    const time = Renkon.time;
    if (gameState.state === "showWinner") {return prev;}
    if (gameState.state !== "playOn") {return prev;}
    const {
      smallScale, mainScale,
      halfWidth, halfHeight, landerScale, lineWidth,
      landingAngleTolerance, landingVelocityTolerance
    } = constants;
    let spheres = colliderPositions;
    for (const [shipId, shipState] of shipStates.map) {
      const {x, y, r, velocityY, velocityX, currentFuel} = shipState;
      let myCollisionState = prev.map.get(shipId);

      if (x < -halfWidth - lineWidth ||
        x > halfWidth + lineWidth ||
        y < -halfHeight - lineWidth ||
        y > halfHeight + lineWidth) {
        prev.map.set(shipId, {...myCollisionState, crashInfo: "OUT OF BOUNDS", altitude: 0, time});
        continue;
      }

      const squaredDistance = (v1, v2) => {
        let dx = v1.x - v2.x;
        let dy = v1.y - v2.y;
        return dx * dx + dy * dy;
      };

      // terrainCheck

      let altitude = myCollisionState.altitude;
      let hasLanded;
      let crashInfo = myCollisionState.crashInfo;
      let fuelChange;

      let nextShip = false;
      for (let i = 0; i < spheres.length; i++) {
        const myX = x + spheres[i].position.x * Math.cos(r);
        const myY = y + spheres[i].position.y * Math.sin(r);
        const worldPosition = {x: myX, y: myY, z: 0};
        // spheres[i].getWorldPosition(worldPosition);

        for (let j = 0; j < lineSegmentsModel.length; j++) {
          let leftVector = lineSegments[j][0];
          let rightVector = lineSegments[j][1];

          if (i == 0 && worldPosition.x > leftVector.x && worldPosition.x < rightVector.x) {
            const k = (rightVector.y-leftVector.y)/(rightVector.x-leftVector.x);
            const terrainHeight = leftVector.y + k * (worldPosition.x - leftVector.x);
            altitude = worldPosition.y - mainScale - smallScale - terrainHeight;
            altitude = Math.max(0, altitude);
          }

          let dot = ((worldPosition.x-leftVector.x)*(rightVector.x-leftVector.x) + (worldPosition.y-leftVector.y)*(rightVector.y-leftVector.y)) / squaredDistance(leftVector, rightVector);
          let closestX, closestY, distanceX, distanceY, distanceSquared;

          closestX = leftVector.x + (dot * (rightVector.x - leftVector.x));
          closestY = leftVector.y + (dot * (rightVector.y - leftVector.y));

          if (closestX < leftVector.x ||
            closestX > rightVector.x ||
            closestY > Math.max(leftVector.y, rightVector.y) ||
            closestY < Math.min(leftVector.y, rightVector.y)) continue;

          distanceX = closestX - worldPosition.x;
          distanceY = closestY - worldPosition.y;
          distanceSquared = distanceX*distanceX + distanceY*distanceY;

          let radius=mainScale;
          if(i>0) radius=smallScale;

          let hitDistance = radius + lineWidth;        

          if(distanceSquared <= hitDistance*hitDistance) {
            hasLanded = true;
            if(Math.min(x - leftVector.x, rightVector.x - x) < (landerScale*0.38)) {
              crashInfo = "TOO CLOSE TO EDGE OF TERRAIN";
              hasLanded = false;
            }
            if(heightDifferences[j] > 0.0001 ) {
              crashInfo = "CRASHED ON UNEVEN TERRAIN";
              hasLanded = false;
            }
            if(Math.abs(r) > landingAngleTolerance) {
              crashInfo = "LANDING ANGLE WAS TOO HIGH";
              hasLanded = false;
            }
            if(velocityX*velocityX + velocityY*velocityY > landingVelocityTolerance*landingVelocityTolerance) {
              crashInfo = "LANDING VELOCITY WAS TOO HIGH";
              hasLanded = false;
            }
            if(hasLanded || crashInfo) {
              prev.map.set(shipId, {landed: hasLanded, crashInfo: crashInfo, altitude: 0, time});
              nextShip = true;
              break;
            }
          }
          if (nextShip) {
            break;
          }
        }
        if (nextShip) {
          break;
        }
      }
      prev.map.set(shipId, {...prev.map.get(shipId), altitude});
    }
    return {map: prev.map};
  }
);

const collisionJudge = Behaviors.select(
  {survivors: new Set()},
  collisionState, (prev, collisionState) => {
    for (const [colId, col] of collisionState.map) {
      if (col.landed) {
        console.log("landed", col);
        Events.send(somebodyLanded, {collisionStateMap: collisionState.map, landed: col, winner: colId, winnerName: players.map.get(colId).color});
        return {survivors: new Set()};
      }
    }
    const newSurvivors = new Set([...collisionState.map].filter(([id, col]) => col.crashInfo === "").map(pair => pair[0]));
    if (newSurvivors.size > prev.survivors.size) {
      return {survivors: newSurvivors}
    }
    const diff = prev.survivors.difference(newSurvivors);
    if (diff.size === 0) {
      return prev;
    }

    Events.send(somebodyCrashed, {collisionStateMap: collisionState.map, survivors: newSurvivors, newCrash: diff});
    return {survivors: newSurvivors};
  }
);

