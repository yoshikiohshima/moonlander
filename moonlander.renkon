[`25`, `const joystick = renkon.querySelector("#joystick");
const knob = renkon.querySelector("#knob");

const thruster = renkon.querySelector("#thruster");
const dummyText = renkon.querySelector("#dummyText");

const preventAndReturn = (e) => {
  e.preventDefault();
  e.stopImmediatePropagation();
  return e;  
};

const release = (e) => {
  if (joystickCapture[0] === e.pointerId) {
    try {
      joystick.releasePointerCapture(e.pointerId);
    } catch(e) {
    }
    joystickCapture[0] = null;    
  }
  preventAndReturn(e); 
  return e;
};

const documentDown = Events.listener(document, "pointerdown", (ev) => {
  setTimeout(() => dummyText.focus(), 0);
}, {capture: true});

const joystickCapture = [null];

const onpointerdown = Events.listener(joystick, "pointerdown", (e) => {
  if (joystickCapture[0] === null) {
    joystick.setPointerCapture(e.pointerId);
    joystickCapture[0] = e.pointerId;
  }
  preventAndReturn(e);
  return e;
});

const onpointermove = Events.listener(joystick, "pointermove", (e) => e);

const onpointerup = Events.listener(document, "pointerup", release);

const thrusterdown = Events.listener(thruster, "pointerdown", preventAndReturn);
const thrusterup = Events.listener(thruster, "pointerup", preventAndReturn);

const cancel = Events.listener(document, "pointercancel", release);
const menu = Events.listener(document, "contextmenu", release);
const touchend = Events.listener(document, "touchend", release);

const tCancel = Events.listener(thruster, "pointercancel", preventAndReturn);
const tMenu = Events.listener(thruster, "contextmenu", preventAndReturn);
const tTouchend = Events.listener(thruster, "touchend", preventAndReturn);

const upKind = Events.or(onpointerup, cancel, menu, touchend);
const tUp = Events.or(thrusterup, tCancel, tMenu, tTouchend);

const joystickControl = Events.select(
  {joystick: true, pointerId: null,
   x: 0, y: 0,rotatingLeft: false, rotatingRight: false, notFocused: true},
  upKind, (prev, e) => {
    let pointerId = prev.pointerId;
    if (prev.pointerId === e.pointerId) {
    }
    pointerId = null;
    knob.style.left = \`20px\`;
    knob.style.top = \`20px\`;
    return {...prev, pointerId, rotatingRight: false, rotatingLeft: false};
  },
  onpointerdown, (prev, e) => {
    if (prev.pointerId === null) {
      const pointerId = e.pointerId;
      const x = e.clientX;
      const y = e.clientY;
      //joystick.style.top = \`\${y - 60}px\`;
      joystick.style.display = "block";
      return {joystick: true, pointerId, x, y, rotatingLeft: false, rotatingRight: false};
    }
    return prev;
  },
  onpointermove, (prev, e) => {
    let rotatingRight = prev.rotatingRight;
    let rotatingLeft = prev.rotatingLeft;
    if (prev.pointerId === e.pointerId) {
      let dx = e.clientX - prev.x;
      let dy = e.clientY - prev.y;
      if (dx > 30) {
        dx = 30;
        rotatingRight = true;
      } else {
        rotatingRight = false;
      }
      if (dx < -30) {
        dx = -30;
        rotatingLeft = true;
      } else {
        rotatingLeft = false;
      }
      knob.style.left = \`\${20 + dx}px\`;
    }
    return {...prev, rotatingRight, rotatingLeft};
  }
);

const thrusterControl = Events.select(
  {thruster: true, pointerId: null, accelerating: false},
  tUp, (prev, e) => {
    const pointerId = null;
    return {...prev, pointerId, accelerating: false};
  },
  thrusterdown, (prev, e) => {
    const pointerId = e.pointerId;
    return {thruster: true, pointerId, accelerating: true};
  }
);
`],
[`31`, `const {sceneHud, hudCanvas, hudContext, hudTexture, hudWidth, hudHeight, cameraHud} = ((THREE) => {
  // initHud
  const hudWidth = window.innerWidth;
  const hudHeight = window.innerHeight;
  const {halfWidth, halfHeight, gameWidth, gameHeight} = constants;

  const cameraHud = new THREE.OrthographicCamera(
    -halfWidth, 
    halfWidth, 
    halfHeight, 
    -halfHeight, 
    0, 
    1000 );
  const sceneHud = new THREE.Scene();
  const hudCanvas = document.createElement('canvas');
  const hudContext = hudCanvas.getContext('2d');
  hudCanvas.width = hudWidth;
  hudCanvas.height = hudHeight;

  const hudTexture = new THREE.Texture(hudCanvas);
  const hudMaterial = new THREE.MeshBasicMaterial( {map: hudTexture} );
  hudMaterial.transparent = true;

  const planeGeometry = new THREE.PlaneGeometry(gameWidth, gameHeight);
  const hudPlane = new THREE.Mesh(planeGeometry, hudMaterial);
  sceneHud.add(hudPlane);
  return {sceneHud, hudCanvas, hudContext, hudTexture, hudWidth, hudHeight, cameraHud}
})(THREE, visibleHalfW);

const hudState = Behaviors.select(
  {hudContext, hudCanvas, hudContext, hudTexture, hudWidth, hudHeight, cameraHud, sceneHud},
  resize, (prev, _resize) => {
    const hudWidth = window.innerWidth;
    const hudHeight = window.innerHeight;
    prev.hudCanvas.width = hudWidth;
    prev.hudCanvas.height = hudHeight;
    return {...prev, hudWidth, hudHeight};
  });

const localShipState = shipStates.map.get(viewId);
const fuelAlertText = "";

function fillLeftInfoPanel(gameState, hudState, shipState, collisionState) {
