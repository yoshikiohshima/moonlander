/*
const crashSound = new sound("audio/crash.mp3");
const rocketSound = new sound("audio/rocket.mp3");
const lowFuelSound = new sound("audio/alarm.mp3");
const commSound = new sound("audio/morse.mp3");
*/
class sound{
  constructor(src) {
    this.sound = document.createElement("audio");
    this.sound.src = src;
    this.sound.setAttribute("preload", "auto");
    this.sound.setAttribute("controls", "none");
    this.sound.style.display = "none";
    document.body.appendChild(this.sound);
  }

  play() {
    this.sound.play();
  }

  stop() {
    this.sound.pause();
  }

  loop() {
    this.sound.addEventListener('timeupdate', function(){
      let buffer = 0.42;
      if(this.currentTime > this.sound.duration - buffer){
        this.currentTime = 0;
        this.play();
      }
    });
  }
}

const hasFuel = Behaviors.select(
  true,
  shipStates, (prev, shipStates) => {
    if(shipStates.map.get(viewId).currentFuel <  0.0001) {
      return false;
    }
    return prev;
  }
)`],
