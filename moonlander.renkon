);

const timer = Events.timer(4);

const init = undefined;`],
[`42`, `const somebodyLanded = Events.receiver({queued: true});
const somebodyCrashed = Events.receiver({queued: true});
const newRound = Events.receiver();

const gameState = Behaviors.select(
  {isDebugOn: false, state: "isBetweenRounds", since: 0},
  somebodyLanded, (prev, somebodyLandedArray) => {
    console.log("somebodyLanded", somebodyLandedArray);
    const sorted = [...somebodyLandedArray].sort((a, b) => b.time - a.time);
    return {...prev, state: "showWinner", since: sorted[0].time};
  },
  somebodyCrashed, (prev, somebodyCrashedArray) => {
    console.log("somebodyCrashed", somebodyCrashedArray);
    const sorted = [...somebodyCrashedArray].sort((a, b) => b.time - a.time);
    return {...prev, state: "showWinner", since: sorted[0].time};    
  },
  timerState, (prev, timerState) => {
    if (prev.state === "isBetweenRounds") {
      if (timerState.now - prev.since > 3000) {
        return {...prev, state: "playOn", since: timerState.now};
      }
    }
    if (prev.state === "showWinner") {
      if (timerState.now - prev.since > 3000) {
        Events.send(newRound, true);
        return {state: "isBetweenRounds", since: timerState.now};
      }
    }
    return prev;
  }
);
  
const collisionState = Behaviors.select(
  {landed: false, crashInfo: "", altitude: 0, fuelChange: 0, isZoomed: false, zoomChanged: false, time: -1},
  newRound, (_prev, _newRound) => {
    console.log("newRound collisionState");
    return {
      landed: false, crashInfo: "", altitude: 0, fuelChange: 0, isZoomed: false, zoomChanged: true, time: -1
    }
  },
  shipState, (prev, shipState) => {
    // orderCheck
    const time = shipState.time;
    if (gameState.state === "showWinnder") {return prev;}
    if (gameState.state !== "playOn") {return prev;}
    const {x, y, r, velocityY, velocityX, currentFuel} = shipState;
    const {
      smallScale, mainScale,
      halfWidth, halfHeight, landerScale, lineWidth,
      landingAngleTolerance, landingVelocityTolerance,
      fuelGainMax, fuelGainMin, fuelGainExtra, fuelPenaltyMax, fuelPenaltyMin,
      cameraZoomAltitude, cameraZoomOutAltitude} = constants;
    if(x < -halfWidth - lineWidth ||
       x > halfWidth + lineWidth ||
       y < -halfHeight - lineWidth ||
       y > halfHeight + lineWidth){
      return {...prev, crashInfo: "OUT OF BOUNDS", altitude: 0, zoomChanged: prev.isZoomed, isZoomed: false, time};
    }

    // terrainCheck
    let i,j;

    let spheres = colliders.children;
    let altitude = prev.altitude;
    let hasLanded;
    let crashInfo;
    let fuelChange;
    let isZoomed = prev.isZoomed;
    let zoomChanged = false;

    for (i = 0; i < spheres.length; i++) {
      let worldPosition = new THREE.Vector3();
      spheres[i].getWorldPosition(worldPosition);

      for (j = 0; j < lineSegments.length; j++) {
        let leftVector = lineSegments[j][0];
        let rightVector = lineSegments[j][1];

        if (i == 0 && worldPosition.x > leftVector.x && worldPosition.x < rightVector.x){
          const k = (rightVector.y-leftVector.y)/(rightVector.x-leftVector.x);
          const terrainHeight = leftVector.y + k * (worldPosition.x - leftVector.x);
          altitude = worldPosition.y - mainScale - smallScale - terrainHeight;
          altitude = Math.max(0, altitude);
        }

        let dot = ((worldPosition.x-leftVector.x)*(rightVector.x-leftVector.x) + (worldPosition.y-leftVector.y)*(rightVector.y-leftVector.y)) / leftVector.distanceToSquared(rightVector);
        let closestX, closestY, distanceX, distanceY, distanceSquared;

        closestX = leftVector.x + (dot * (rightVector.x - leftVector.x));
        closestY = leftVector.y + (dot * (rightVector.y - leftVector.y));

        if (closestX < leftVector.x ||
            closestX > rightVector.x ||
            closestY > Math.max(leftVector.y, rightVector.y) ||
            closestY < Math.min(leftVector.y, rightVector.y)) continue;

        distanceX = closestX - worldPosition.x;
        distanceY = closestY - worldPosition.y;
        distanceSquared = distanceX*distanceX + distanceY*distanceY;

        let radius=mainScale;
        if(i>0) radius=smallScale;

        let hitDistance = radius + lineWidth;        

        if(distanceSquared <= hitDistance*hitDistance) {
          hasLanded = true;
          if(Math.min(x - leftVector.x, rightVector.x - x) < (landerScale*0.38)) {
            crashInfo = "TOO CLOSE TO EDGE OF TERRAIN";
            hasLanded = false;
          }
          if(heightDifferences[j] > 0.0001 ) {
            crashInfo = "CRASHED ON UNEVEN TERRAIN";
            hasLanded = false;
          }
          if(Math.abs(r) > landingAngleTolerance) {
            crashInfo = "LANDING ANGLE WAS TOO HIGH";
            hasLanded = false;
          }
          if(velocityX*velocityX + velocityY*velocityY > landingVelocityTolerance*landingVelocityTolerance) {
            crashInfo = "LANDING VELOCITY WAS TOO HIGH";
            hasLanded = false;
          }
          let mul = 1;
          if (hasLanded) {
            console.log("hasLanded")
            fuelChange = Math.random() * (fuelGainMax - fuelGainMin) + fuelGainMin;
            fuelChange += fuelGainExtra * mul;
          } else if (crashInfo)
            console.log("hasCrashed")
            fuelChange = Math.random() * (fuelPenaltyMax - fuelPenaltyMin) + fuelPenaltyMin;
            fuelChange = Math.min(fuelChange, currentFuel);
          }
          if(hasLanded || crashInfo) {
            return {landed: hasLanded, crashInfo: crashInfo, fuelChange, altitude: 0, zoomChanged: prev.isZoomed === false, isZoomed: true, time};
          }
        }
      }
      if (gameState.state !== "playOn") {
        isZoomed = false;
        if (prev.isZoomed) zoomChanged = true;
      } else if (altitude <= cameraZoomAltitude || prev.isZoomed && altitude <= cameraZoomOutAltitude) {
        isZoomed = true;
      } else if (prev.isZoomed && altitude >= cameraZoomOutAltitude) {
        isZoomed = false;
      }
      return {...prev, isZoomed, zoomChanged: prev.isZoomed === false, altitude, time};
    });

((collisionState) => {
  if (collisionState.crashInfo !== "") {
    Events.send(somebodyCrashed, collisionState);
  }
  if (collisionState.landed) {
    Events.send(somebodyLanded, collisionState);
  }
})(collisionState);


const shipState = Behaviors.select(
  {
    x: 0, y: 0, r: 0, visible: true,
    velocityDeltaX: 0, velocityDeltaY: 0,
    currentAcceleration: 0, currentAccelerationRatio: 0,
    currentFuel: 1000,
    landerForward: new THREE.Vector2(0,1),
    landerBackDirection: new THREE.Vector2(0,1),
    velocityX: 0, velocityY: 0,
    time: -1
  },
  newRound, (_prev, _new) => {
    console.log("new ship");
    return {
      x: 0, y: 0, r: 0, visible: true,
      velocityDeltaX: 0, velocityDeltaY: 0,
      currentAcceleration: 0, currentAccelerationRatio: 0,
      currentFuel: 1000,
      landerForward: new THREE.Vector2(0,1),
      landerBackDirection: new THREE.Vector2(0,1),
      velocityX: 0, velocityY: 0,
      time: -1
    }
  },
  gameState, (prev, gameState) => {
    if (gameState.state === "playOn") {
      console.log('play');
      const {initialVelocity, randomPositionX, randomPositionY, randomRotation} = randomSpawn();
      return {...prev, x: randomPositionX, y: randomPositionY, r: randomRotation, velocityX: initialVelocity, velocityY: 0, time: Renkon.now};
    }
    return prev;
  },
  timerState, (prev, timer) => {
    let rotationDelta = 0;
    if (gameState.state === "showWinner") {return prev;}
    
    const deltaTime = timer.delta;
    const time = timer.now;
    let {x, y, r, landerForward} = prev;
    const {rotatingRight, rotatingLeft, accelerating} = controlState;
    const {
      angularVelocity, thrusterJerk, thrusterAccelerationMax, gravity,
      fuelConsumptionRateMax, fuelConsumptionRateMin,
      accelerationFalloffMultiplier, horizontalDragCoef} = constants;
    
    if(rotatingLeft) rotationDelta += angularVelocity * deltaTime;
    if(rotatingRight) rotationDelta += -angularVelocity * deltaTime;

    // lander.rotation.z += rotationDelta;
    r += rotationDelta;
    // console.log(r)

    // if(lander.rotation.z > Math.PI / 2) lander.rotation.z = Math.PI / 2;
    // if(lander.rotation.z < -Math.PI / 2) lander.rotation.z = -Math.PI / 2;
    if(r > Math.PI / 2) r = Math.PI / 2;
    if(r < -Math.PI / 2) r = -Math.PI / 2;
    
    let velocityDeltaY = 0;
    let velocityDeltaX = 0;

    velocityDeltaY += -gravity * deltaTime;
    let currentAcceleration = prev.currentAcceleration;
    let currentAccelerationRatio = prev.currentAccelerationRatio;
    let currentFuel = prev.currentFuel;
    let velocityX = prev.velocityX;
    let velocityY = prev.velocityY;

    if(accelerating && currentFuel > 0) {
      rocketSound.play();

      currentAcceleration += thrusterJerk * deltaTime;
      if(currentAcceleration > thrusterAccelerationMax) currentAcceleration = thrusterAccelerationMax;

      currentAccelerationRatio = currentAcceleration / thrusterAccelerationMax;
      let fuelBurned = currentAccelerationRatio * (fuelConsumptionRateMax - fuelConsumptionRateMin) + fuelConsumptionRateMin;
      currentFuel -= fuelBurned * deltaTime;
      if (currentFuel < 0.0001) currentFuel = 0;
      // fuelCheck();
      // fuelAlertCheck();
     // console.log(currentAcceleration);
    } else {
      rocketSound.stop();

      currentAcceleration -= thrusterJerk * deltaTime * accelerationFalloffMultiplier;
      if(currentAcceleration < 0) currentAcceleration = 0;
    }

    landerForward.x = 0;
    landerForward.y = 1;
    const vector2Zero = new THREE.Vector2(0,0);
    landerForward.rotateAround(vector2Zero, r);
    prev.landerBackDirection.x = -landerForward.x;
    prev.landerBackDirection.y = -landerForward.y;

    velocityDeltaX += -velocityX * horizontalDragCoef * deltaTime;

    velocityDeltaX += landerForward.x * currentAcceleration * deltaTime;
    velocityDeltaY += landerForward.y * currentAcceleration * deltaTime;

    velocityY += velocityDeltaY;
    velocityX += velocityDeltaX;

    // console.log(velocityX, velocityY);
  
    let positionDeltaY = velocityY * deltaTime
    // lander.position.y += positionDeltaY;
    y += positionDeltaY;

    let positionDeltaX = velocityX * deltaTime;
    // lander.position.x += positionDeltaX;
    x += positionDeltaX;
    return {
      x, y, r, visible: prev.visible,
      velocityDeltaX, velocityDeltaY,
      currentAcceleration, currentFuel, currentAccelerationRatio,
      landerForward, landerBackDirection: prev.landerBackDirection,
      velocityX, velocityY, time} 
});
`],
[`160`, `const controlState = Behaviors.select(
  {rotatingRight: false, rotatingLeft: false, accelerating: false},
  keys, (prev, keys) => {
    const value = {...prev};
    if (keys.includes("ArrowLeftDown")) {
      value.rotatingLeft = true;
    }
    if (keys.includes("ArrowRightDown")) {
      value.rotatingRight = true;
    }
    if (keys.includes("ArrowUpDown")) {
      value.accelerating = true;
    }
    if (keys.includes("ArrowLeftUp")) {
      value.rotatingLeft = false;
    }
    if (keys.includes("ArrowRightUp")) {
      value.rotatingRight = false;
    }
    if (keys.includes("ArrowUpUp")) {
      value.accelerating = false;
    }
    return value;
  },
);

const keyLeftDown = Events.listener(
  document.body, "keydown", 
  (evt) => evt.key === "ArrowLeft" ? evt.key + "Down" : undefined
);

const keyRightDown = Events.listener(
  document.body, "keydown",
  (evt) => evt.key === "ArrowRight" ? evt.key + "Down" : undefined
);

const keyUpDown = Events.listener(
  document.body, "keydown",
  (evt) => evt.key === "ArrowUp" ? evt.key + "Down" : undefined
);

const keyLeftUp = Events.listener(
  document.body, "keyup", 
  (evt) => evt.key === "ArrowLeft" ? evt.key + "Up" : undefined
);

const keyRightUp = Events.listener(
  document.body, "keyup",
  (evt) => evt.key === "ArrowRight" ? evt.key + "Up" : undefined
);

const keyUpUp = Events.listener(
  document.body, "keyup",
  (evt) => evt.key === "ArrowUp" ? evt.key + "Up": undefined
);

const keys = Events.some(keyLeftDown, keyRightDown, keyUpDown, keyLeftUp, keyRightUp, keyUpUp);
`]]}