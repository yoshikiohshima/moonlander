const updateParticles = ((thrustersAndExplosions, controlStates, gameState, shipStates, render) => {
  const {thrusterPSs, explosionPSs} = thrustersAndExplosions;
  const deltaTime = render.delta;
  const playOn = gameState.state === "playOn";
  for (const [shipId, shipState] of shipStates.map) {
    const thrusterPS = thrusterPSs.get(shipId);
    const explosionPS = explosionPSs.get(shipId);
    const controlState = controlStates.map.get(shipId);
    const accelerating = controlState ? controlState.accelerating : false;
    const {currentFuel, velocityX, velocityY, currentAcceleration, landerBackDirection} = shipState;
    const hasFuel = currentFuel > 0;
    thrusterPS.emitting = (accelerating && hasFuel && playOn);
    thrusterPS.initialVelocityX = velocityX;
    thrusterPS.initialVelocityY = velocityY;
    thrusterPS.direction = landerBackDirection;
    thrusterPS.update(deltaTime, currentAcceleration);

    explosionPS.initialVelocityX = velocityX;
    explosionPS.initialVelocityY = velocityY;
    explosionPS.update(deltaTime);
  }
  return {thrusterPSs, explosionPSs};
})(thrustersAndExplosions, controlStates, gameState, shipStates, render);

const emitChecker = ((collisionState, thrustersAndExplosions) => {
  for (const [shipId, colState] of collisionState.map) {
    const explosionPS = thrustersAndExplosions.explosionPSs.get(shipId);
    if (colState.crashInfo !== "") {
      explosionPS.emit();
    } else {
      explosionPS.unemit();
    }
  }
})(collisionState, updateParticles);`],
