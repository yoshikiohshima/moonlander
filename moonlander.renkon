{__codeMap: true, value: [[`1`, `const gameWidth = 800;
const gameHeight = 450;
const halfWidth = gameWidth/2;
const halfHeight = gameHeight/2;

const landerScale = 8;

const constants = {
  gameWidth,
  gameHeight,
  halfWidth, halfHeight,
  lineWidth: 0.5,

  zoom: 4,
  cameraZoomAltitude: 120,
  cameraZoomOutAltitude: 130,
  cameraPositionDefault:  [0, 0, 5],

  verticalTopSpawnOffset: 50,
  verticalMiddleSpawnOffset: 170,
  horizontalSpawnOffset: 80,
  middleSpawnOffset: 120,
  velocityXSpawnMin: 30,
  velocityXSpawnMax: 50,

  landerScale,
  gravity: 1.62,
  thrusterAccelerationMax: 4,
  thrusterJerk: 4,
  accelerationFalloffMultiplier: 2,
  angularVelocity: 90 * (Math.PI / 180),
  horizontalDragCoef: 0.04,

  mainScale: landerScale/2,
  smallScale: landerScale/8,

  startingFuel: 500,
  fuelConsumptionRateMin: 4,
  fuelConsumptionRateMax: 14,
  fuelAlertThreshold: 300,

  landingAngleTolerance: 6.7 * (Math.PI / 180),
  landingVelocityTolerance: 5.0,
};

console.log("constants", constants)
`],
[`2`, `const renkon = (() => {
  const radar = document.createElement("canvas");
  radar.id = "radar";
  document.body.querySelector(\`#\${radar.id}\`)?.remove();
  document.body.appendChild(radar);

  const joystickDiv = document.createElement("div");
  joystickDiv.innerHTML = \`<div id="joystick"><div id="knob"></div></div>\`;
  const joystick = joystickDiv.querySelector("#joystick");
  document.body.querySelector(\`#\${joystick.id}\`)?.remove();
  document.body.appendChild(joystick);

  const thruster = document.createElement("div");
  thruster.id = "thruster";
  thruster.classList.add("noSelect");
  //const label = document.createElement("div");
  //label.textContent = "T";
  //label.classList.add("noSelect");
  //thruster.appendChild(label);
  document.body.querySelector(\`#\${thruster.id}\`)?.remove();
  document.body.appendChild(thruster);

  const dummyText = document.createElement("input");
  dummyText.id = "dummyText";
  document.body.querySelector(\`#\${dummyText.id}\`)?.remove();
  document.body.appendChild(dummyText);

  const script = document.createElement("script");
  script.src = "https://unpkg.com/three@0.124.0";
  script.id = "three";
  return new Promise((resolve) => {
    script.onload = () => resolve(document.body);
    document.head.querySelector(\`#\${script.id}\`)?.remove();
    document.head.appendChild(script);
  });
})();

const THREE = (() => {return window.THREE})(renkon);

const css = \`
body {
    margin: 0;
    background-color: #000000;
    overflow: hidden;
    touch-action: none;
}
canvas {
    width: 100%;
    height: 100%;
}

#moonlander {
  position: fixed;
  top: 0px;
  left: 0px;
  width: 100%;
  height: 100%
}

#radar {
  position: fixed;
  width: 200px;
  height: 113px;
  top: 0px;
  left: 0px;
}
#joystick {
    position: absolute;
    left: 50px;
    bottom: 50px;
    width: 80px;
    height: 80px;
    border: 3px solid #FFF;
    border-radius: 40px;
    opacity: 0.5;
}
#knob {
    position: absolute;
    left: 20px;
    top: 20px;
    width: 40px;
    height: 40px;
    border-radius: 20px;
    background-color: #FFF;
}

#thruster {
    position: absolute;
    right: 50px;
    bottom: 50px;
    width: 40px;
    height: 40px;
    border-radius: 20px;
    border: 1pt solid white;
    background-color: #FFF;
    user-select: none;
    display: flex;
    align-items: center;
    justify-content: center;
}

.noSelect {
  user-select: none;
  -webkit-user-select: none;
}
\`;

((css, renkon) => {
  const c = document.createElement("style");
  c.textContent = css;
  c.id = "lander-css";
  document.head.querySelector(\`#\${c.id}\`)?.remove();
  document.head.appendChild(c);
  return renkon;
})(css, renkon);`],
[`7`, `const {scene, camera, renderer} = ((THREE) => {
  console.log("scene");
  const scene = new THREE.Scene();
  const {landerScale, cameraPositionDefault, halfHeight} = constants;
  
  const camera = new THREE.OrthographicCamera(
      -0,
      0,
      halfHeight,
      -halfHeight,
      0.1,
      1000);
  scene.add(camera);
  camera.position.set(...cameraPositionDefault);

  const renderer = new THREE.WebGLRenderer({antialias: true});
  renderer.setSize(window.innerWidth, window.innerHeight);
  renderer.autoClear = false;
  renderer.domElement.id = "moonlander";
  document.body.querySelector("#moonlander")?.remove();
  document.body.insertBefore(renderer.domElement, document.body.querySelector("#radar"));

  return {scene, renderer, camera};
})(THREE);

function newLander(id) {
  console.log("new lander", id);
  const {mainScale, smallScale} = constants;
  const geometry = new THREE.PlaneGeometry(constants.landerScale, constants.landerScale);
  const texture = new THREE.TextureLoader().load('textures/lander.png');
  const material = new THREE.MeshBasicMaterial({map: texture});
  material.transparent = true;
  const lander = new THREE.Mesh(geometry, material);
  lander.name = id;
  scene.add(lander);
  return lander;
}

const landers = Behaviors.select(
  {map: new Map([...shipStates.map.keys()].map((id) => ([id, newLander(id)])))},
  shipStates, (prev, shipStates) => {
    const prevKeys = [...prev.map.keys()];
    const newKeys = [...shipStates.map.keys()];
    const olds = prevKeys.filter((e) => !newKeys.includes(e));
    const news = newKeys.filter((e) => !prevKeys.includes(e));
    let changed = false;
    olds.forEach((shipId) => {
      changed = true;
      const old = prev.map.get(shipId);
      if (old) scene.remove(old);
      prev.map.delete(shipId);      
    });
    news.forEach((shipId) => {
      changed = true;
      prev.map.set(shipId, newLander(shipId));
    });
    return changed ? {map: prev.map} : prev;
  }
);

const borders = ((THREE, scene) => {
  // createBorders
  let borders = new THREE.Group();
  scene.add(borders);

  const {lineWidth, gameHeight, gameWidth, halfWidth, halfHeight} = constants;

  const verticalGeometry = new THREE.PlaneGeometry(lineWidth, gameHeight + lineWidth*2);
  const horizontalGeometry = new THREE.PlaneGeometry(gameWidth + lineWidth*2, lineWidth);
  const material = new THREE.MeshBasicMaterial({color: 0xffffff});
  let leftBorder = new THREE.Mesh(verticalGeometry, material);
  let rightBorder = new THREE.Mesh(verticalGeometry, material);
  let topBorder = new THREE.Mesh(horizontalGeometry, material);
  let botBorder = new THREE.Mesh(horizontalGeometry, material);
  borders.add(leftBorder);
  borders.add(rightBorder);
  borders.add(topBorder);
  borders.add(botBorder);

  let verticalOffset = halfWidth + lineWidth/2;
  let horizontalOffset = halfHeight + lineWidth/2;
  leftBorder.position.x = -verticalOffset;
  rightBorder.position.x = verticalOffset;
  topBorder.position.y = horizontalOffset;
  botBorder.position.y = -horizontalOffset;
  return borders;
})(THREE, scene);

const {lineSegments} = ((scene, points) => {
  const terrainMeshGroup = new THREE.Group();
  const lineSegments = [];
  const heightDifferences = [];
  
  scene.add(terrainMeshGroup);
  const {halfWidth, halfHeight, lineWidth} = constants;

  function placeTerrainSegment(leftPoint, rightPoint, lineSegments) {
    let leftVector = new THREE.Vector2(leftPoint[0] - halfWidth, leftPoint[1] - halfHeight);
    let rightVector = new THREE.Vector2(rightPoint[0] - halfWidth, rightPoint[1] - halfHeight);
  
    lineSegments.push([leftVector.clone(), rightVector.clone()]);
  
    let center = leftVector.add(rightVector).divideScalar(2);
    let distance = leftVector.distanceTo(rightVector);
  
    const geometry = new THREE.PlaneGeometry(distance*2 + lineWidth/2, lineWidth);
    const material = new THREE.MeshBasicMaterial({color: 0xffffff});
    let terrainMesh = new THREE.Mesh(geometry, material);
    terrainMesh.position.x = center.x;
    terrainMesh.position.y = center.y;
  
    let direction = rightVector.sub(leftVector);
    let angle = direction.angle();
  
    terrainMesh.rotation.z = angle;
    terrainMeshGroup.add(terrainMesh);
  }

  for(let i=0; i<points.length-1; i++) {
    placeTerrainSegment(points[i], points[i+1], lineSegments);
  }
  return {lineSegments};
})(scene, points);

const {stars} = ((THREE, scene) => {
  // createStars
  let stars = new THREE.Group();
  scene.add(stars);

  const {numOfStars} = viewConstants;

  const {gameWidth, gameHeight, landerScale} = constants;

  let j;
  for(let i = 0; i < numOfStars; i++) {
    let randomX, randomY;
    randomX = (Math.random() - 0.5) * gameWidth;
    randomY = (Math.random() - 0.5) * gameHeight;

    const geometry = new THREE.PlaneGeometry(landerScale/10, landerScale/5);
    const material = new THREE.MeshBasicMaterial({color: 0xffffff});
    let mesh = new THREE.Mesh(geometry, material);
    stars.add(mesh);

    mesh.position.x = randomX;
    mesh.position.y = randomY;
    mesh.position.z = -5;

    for(j = 0; j < lineSegments.length; j++) {
      let leftVector = lineSegments[j][0];
      let rightVector = lineSegments[j][1];

      if(randomX > leftVector.x && randomX < rightVector.x) {
        if(randomY < Math.max(leftVector.y, rightVector.y)) {
            mesh.visible = false;
        }
        break;
      }
    }
  }
  return {stars};
})(THREE, scene);

const visibleHalfW = Behaviors.select(
  halfHeight * window.innerWidth / window.innerHeight,
  resize, (_prev, _resize) => halfHeight * window.innerWidth / window.innerHeight
);

const resizeFunction = (_prev, _resize) => {
  // onWindowResize
  renderer.setSize(window.innerWidth, window.innerHeight);
  camera.left  = -visibleHalfW;
  camera.right =  visibleHalfW;
  camera.updateProjectionMatrix();
  return {};
};

const resizer = Behaviors.select(
  resizeFunction(),
  resize, resizeFunction
);

const resize = Events.listener(window, "resize", (evt) => evt);
const keydown = Events.listener(window, "keydown", (evt) => evt);
const keyup = Events.listener(window, "keyup", (evt) => evt);
const visibilityChange = Events.listener(document, "visibilitychange", (evt) => evt);

const render = ((scene, renderer, gameState, hudState, shipStates, positionedLanders, controlStates, collisionState, camera, resizer, timerState, viewTimer) => {
  let trajectory;
  const landers = positionedLanders.landers;
  const diffYs = positionedLanders.diffYs;
  const {isDebugOn} = gameState;
  const {cameraPositionDefault, zoom, halfWidth} = constants;
  const shipState = shipStates.map.get(viewId);
  // if (!shipState.currentFuel) debugger;
  if (isDebugOn) {
    trajectory = generateTrajectoryMesh(calculateTrajectory(shipState));
    scene.add(trajectory)
  }

  const lander = landers.map.get(viewId);
  const myCollisionState = collisionState.map.get(viewId);
  if (!myCollisionState) {
    console.log("collisionState not found:", viewId);
  }

  const {altitude, crashInfo} = myCollisionState;
  const crashed = crashInfo !== "";
  const {isZoomed, zoomChanged} = renderState;
  const z = cameraPositionDefault[2];
  if (isZoomed) {
    camera.position.set(lander.position.x, (lander.position.y - diffYs.get(viewId)) - altitude/2, z);
    camera.zoom = zoom;
    camera.updateProjectionMatrix();
  } else if (zoomChanged && isZoomed === false) {
    camera.position.y = 0;
    camera.position.z = z;
    camera.zoom = 1;
    const maxPan = halfWidth - visibleHalfW;
    if (maxPan > 0) {
      // Clamp so neither edge of the viewport exceeds the world boundary
      camera.position.x = Math.max(-maxPan, Math.min(maxPan, lander.position.x));
    } else {
      // Viewport is as wide (or wider) than the world — keep centred
      camera.position.x = 0;
    }   
    camera.updateProjectionMatrix();
  }

  renderer.render(scene, camera);
  renderHud(renderer, gameState, hudState, shipState, myCollisionState, timerState);
  renderRadar(radarCtx, radarCanvas, shipStates, controlStates, myCollisionState, visibleHalfW);

  if (isDebugOn) {
    scene.remove(trajectory);
  }
  return {delta: timerState.delta};
})(scene, renderer, gameState, hudState, shipStates, positionedLanders, controlStates, collisionState, camera, resizer, timerState, viewTimer);

const renderHud = (renderer, gameState, hudState, shipState, collisionState, timerState) => {
  const {hudWidth, hudHeight, hudTexture, sceneHud, cameraHud} = hudState;
  hudState.hudContext.clearRect(0, 0, hudWidth, hudHeight);

  fillLeftInfoPanel(gameState, hudState, shipState, collisionState);
  fillRightInfoPanel(gameState, hudState, shipState, collisionState);
  fillMainPanel(gameState, hudState, shipState, collisionState, timerState);

  hudTexture.needsUpdate = true;
  renderer.render(sceneHud, cameraHud);
}

function calculateTrajectory(shipState) {
  const {x, y, velocityX, velocityY} = shipState;
  const {halfHeight, horizontalDragCoef, gravity} = constants;
  let x0 = x; // lander.position.x;
  let y0 = y; // lander.position.y;
  let tAx = 0;
  let tAy = -gravity;
  let tVx = velocityX;
  let tVy = velocityY;
  const dt = 1.0/60;

  let res = [[x0,y0]];

  while (y0 > -halfHeight) {
    tAx = -tVx * horizontalDragCoef;

    tVx += tAx * dt;
    tVy += tAy * dt;

    const x1 = x0 + tVx*dt;
    const y1 = y0 + tVy*dt;

    res.push([x1,y1]);

    x0 = x1;
    y0 = y1;
  }

  return res;
}

function generateTrajectoryMesh(trajectory) {
  const lineMeshes = new THREE.Group();
  const {lineWidth} = constants;

  const material = new THREE.MeshBasicMaterial({color: 0xffffff});
  const geometry = new THREE.PlaneGeometry(1, 1);

  for (let i = 0; i < trajectory.length-1; i++) {
    const point0 = trajectory[i];
    const point1 = trajectory[i+1];

    const deltaX = point1[0]-point0[0];
    const deltaY = point1[1]-point0[1];

    const middle = [(point0[0] + point1[0])/2, (point0[1] + point1[1])/2];
    const scale = Math.sqrt(Math.pow(deltaX, 2) + Math.pow(deltaY, 2));
    const angle = Math.atan2(deltaY, deltaX);

    const lineMesh = new THREE.Mesh(geometry, material);

    lineMesh.scale.x = scale;
    lineMesh.scale.y = lineWidth;

    lineMesh.position.x = middle[0];
    lineMesh.position.y = middle[1];

    lineMesh.rotation.z = angle;

    lineMeshes.add(lineMesh);
  }
    
  return lineMeshes;
}

const positionedLanders = Events.select(
  {landers: null, renderedModelTime: 0, diffYs: new Map(), renderCount: 0, renderTime: 0},
  viewTimer, (prev, viewTimer) => {
    let deltaTime = 0;
    let renderCount = prev.renderCount;
    const modelTime = Math.max(...[...shipStates.map.values()].map(m => m.time));
    if (modelTime === prev.renderedModelTime) {
      renderCount++;
      deltaTime = 1 / 60;
      // console.log("renderCount", renderCount)
    } else {
      renderCount = 0;
      deltaTime = 0;
    }
    const keys = new Set([...prev.diffYs.keys()]);
    for (const [k, shipState] of shipStates.map) {
      keys.delete(k);
      const {velocityX, velocityY, currentAcceleration, landerForward} = shipState;
      let diffX = 0;
      let diffY = 0;
      let accX = landerForward.x * currentAcceleration;
      let accY = landerForward.y * currentAcceleration;
      for (let i = 0; i < renderCount; i++) {
        diffX += accX * deltaTime;
        diffY += accY * deltaTime;
      }
      diffX += velocityX * renderCount * deltaTime;
      diffY += velocityY * renderCount * deltaTime;
      const colState = collisionState.map.get(k);
      prev.diffYs.set(k, diffY);
      const lander = landers.map.get(k);
      if (!colState) {lander.visible = false; continue;}
      if (colState.landed) {continue;}
      const visible = colState.crashInfo === "";
      lander.visible = visible;
      lander.position.x = shipState.x + diffX;
      lander.position.y = shipState.y + diffY;
      lander.rotation.z = shipState.r;
    }
    [...keys].forEach(k => prev.diffYs.delete(k));
    return {
      landers: landers, renderedModelTime: modelTime, diffYs: prev.diffYs, 
      renderCount, renderTime: Renkon.app?.extrapolatedNow?.()||Renkon.time};
  }
);

const renderState = Behaviors.select(
  {isZoomed: false, zoomChanged: true},
  collisionState, (prev, collisionState) => {
    let {isZoomed, zoomChanged} = prev;
    const myCollisionState = collisionState.map.get(viewId);
    if (!myCollisionState) {return prev;}
    let {altitude} = myCollisionState;
    const {cameraZoomAltitude, cameraZoomOutAltitude} = constants;

    if (gameState.state !== "playOn") {
      isZoomed = false;
    } else if (altitude <= cameraZoomAltitude || prev.isZoomed && altitude <= cameraZoomOutAltitude) {
      isZoomed = true;
    } else if (prev.isZoomed && altitude >= cameraZoomOutAltitude) {
      isZoomed = false;
    }
    if (prev.isZoomed === isZoomed) {
      return prev;
    }
    return {isZoomed, zoomChanged: true};
  }
);`],
[`13`, `const crashSound = new sound("crash");
const rocketSound = new sound("rocket");
const lowFuelSound = new sound("alarm");
const commSound = new sound("morse");
rocketSound.loop();

class sound {
  constructor(shortName) {
    const src = \`audio/\${shortName}.mp3\`;
    this.sound = document.createElement("audio");
    this.sound.src = src;
    this.sound.id = shortName;
    this.sound.setAttribute("preload", "auto");
    this.sound.setAttribute("controls", "none");
    this.sound.style.display = "none";
    document.body.querySelector(\`#\${this.sound.id}\`)?.remove();
    document.body.appendChild(this.sound);
  }

  play() {
    this.sound.play();
  }

  stop() {
    this.sound.pause();
  }

  loop() {
    this.sound.addEventListener('timeupdate', () => {
      let buffer = 0.42;
      if(this.currentTime > this.sound.duration - buffer){
        this.currentTime = 0;
        this.play();
      }
    });
  }
}
`],
[`23`, `const {radarCanvas, radarCtx} = (() => {
  // initRadar;
  const {radarWidth, radarHeight} = viewConstants;
  const radarCanvas = document.getElementById('radar');
  radarCanvas.width  = radarWidth;
  radarCanvas.height = radarHeight;
  const radarCtx = radarCanvas.getContext('2d');
  return {radarCanvas, radarCtx};
})();

const renderRadar = (radarCtx, radarCanvas, shipStates, controlStates, collisionState, visibleHalfW) => {
  const controlState = controlStates.map.get(viewId);
  const isZoomed = collisionState.isZoomed;
  // renderRadar
  const {radarWidth, radarHeight} = viewConstants;
  const {halfWidth, halfHeight, gameWidth, gameHeight, zoom} = constants;
  const ctx = radarCtx;
  const W = radarWidth;
  const H = radarHeight;

  ctx.fillStyle = '#001500';
  ctx.fillRect(0, 0, W, H);

  // World → radar coordinate helpers
  const toRX = wx => (wx + halfWidth)  / gameWidth  * W;
  const toRY = wy => (halfHeight - wy) / gameHeight * H;

  // Terrain: flat landing zones brighter/thicker
  for (let i = 0; i < lineSegments.length; i++) {
    const lv = lineSegments[i][0];
    const rv = lineSegments[i][1];
    const isFlat = heightDifferences[i] < 0.0001;
    ctx.strokeStyle = isFlat ? '#00cc55' : '#2a5530';
    ctx.lineWidth   = isFlat ? 2 : 1;
    ctx.beginPath();
    ctx.moveTo(toRX(lv.x), toRY(lv.y));
    ctx.lineTo(toRX(rv.x), toRY(rv.y));
    ctx.stroke();
  }

  // Viewport rectangle — always shown, brighter when zoomed
  {
    const vwHalf = isZoomed ? visibleHalfW / zoom : visibleHalfW;
    const vhHalf = isZoomed ? halfHeight   / zoom : halfHeight;
    const cx = camera.position.x;
    const cy = isZoomed ? camera.position.y : 0;
    ctx.strokeStyle = isZoomed ? '#44ff88' : '#22cc55';
    ctx.lineWidth = 1;
    ctx.strokeRect(
      toRX(cx - vwHalf),
      toRY(cy + vhHalf),
      (vwHalf * 2 / gameWidth)  * W,
      (vhHalf * 2 / gameHeight) * H
    );
  }

  for (const [shipId, shipState] of shipStates.map) {
    const accelerating = controlState ? controlState.accelerating : false;

    // Lander dot — yellow when thrusting, cyan otherwise
    if (shipState.visible) {
      let fill;
      if (shipId === viewId) {
        fill = accelerating ? '#ffee00' : '#00ffcc';
      } else {
        fill = '#cccccc';
      }
      ctx.fillStyle = fill;
      ctx.beginPath();
      ctx.arc(toRX(shipState.x), toRY(shipState.y), 2.5, 0, Math.PI * 2);
      ctx.fill();
    }
  }
  return radarCanvas;
};

const playRocketSound = ((collisionState, controlStates) => {
  const col = collisionState.map.get(viewId);
  const control = controlStates.map.get(viewId);

  if (col && col.crashInfo === "" && control && control.accelerating) {
    rocketSound.play();
  } else {
    rocketSound.stop();
  }
})(collisionState, controlStates);`],
