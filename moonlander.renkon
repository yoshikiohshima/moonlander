[`2`, `const renkon = (() => {
  const radar = document.createElement("canvas");
  radar.id = "radar";
  document.body.querySelector(\`#\${radar.id}\`)?.remove();
  document.body.appendChild(radar);
  
  const script = document.createElement("script");
  script.src = "https://unpkg.com/three@0.124.0";
  script.id = "three";
  return new Promise((resolve) => {
    script.onload = () => resolve(script);
    document.head.querySelector(\`#\${script.id}\`)?.remove();
    document.head.appendChild(script);
  });
})();

const THREE = (() => {return window.THREE})(renkon);

const css = \`

body {
    margin: 0;
    background-color: #000000;
    overflow: hidden;
    touch-action: none;
}
canvas {
    width: 100%;
    height: 100%;
}

#moonlander {
  position: fixed;
  top: 0px;
  left: 0px;
  width: 100%;
  height: 100%
}

#radar {
  position: fixed;
  width: 200px;
  height: 113px;
  top: 0px;
  left: 0px;
}
\`;

((css, renkon) => {
  const c = document.createElement("style");
  c.textContent = css;
  c.id = "lander-css";
  document.head.querySelector(\`#\${c.id}\`)?.remove();
  document.head.appendChild(c);
})(css, renkon);`],
[`7`, `const {scene, camera, renderer, lander} = ((THREE) => {
  console.log("scenes");
  const scene = new THREE.Scene();
  const {landerScale, cameraPositionDefault, halfHeight} = constants;
  
  const camera = new THREE.OrthographicCamera(
      -0,
      0,
      halfHeight,
      -halfHeight,
      0.1,
      1000);
  scene.add(camera);
  camera.position.set(...cameraPositionDefault);

  const renderer = new THREE.WebGLRenderer({antialias: true});
  renderer.setSize(window.innerWidth, window.innerHeight);
  renderer.autoClear = false;
  renderer.domElement.id = "moonlander";
  document.body.querySelector("#moonlander")?.remove();
  document.body.insertBefore(renderer.domElement, document.body.querySelector("#radar"));

  const geometry = new THREE.PlaneGeometry(landerScale, landerScale);
  const texture = new THREE.TextureLoader().load('textures/lander.png');
  const material = new THREE.MeshBasicMaterial({map: texture});
  material.transparent = true;
  const lander = new THREE.Mesh(geometry, material);
  scene.add(lander);
  // lander.visible = false;
  return {scene, renderer, camera, lander};
})(THREE);

const {colliders} = ((THREE, lander) => {
  // initColliders
  const colliders = new THREE.Group();

  const mainGeometry = new THREE.SphereGeometry(mainScale);
  const smallGeometry = new THREE.SphereGeometry(smallScale);

  const material = new THREE.MeshBasicMaterial({color: 0xffffff});

  let mainCollider = new THREE.Mesh(mainGeometry, material);
  let leftCollider = new THREE.Mesh(smallGeometry, material);
  let rightCollider = new THREE.Mesh(smallGeometry, material);

  colliders.add(mainCollider);
  colliders.add(leftCollider);
  colliders.add(rightCollider);

  const verticalOffset = -mainScale + smallScale;
  leftCollider.position.y = verticalOffset;
  rightCollider.position.y = verticalOffset;

  const horizontalOffset = mainScale - smallScale;
  leftCollider.position.x = -horizontalOffset;
  rightCollider.position.x = horizontalOffset;

  lander.add(colliders);
  colliders.visible = false;
  return {colliders}
})(THREE, lander);

const {borders} = ((THREE, scene) => {
  // createBorders
  let borders = new THREE.Group();
  scene.add(borders);

  const {lineWidth, gameHeight, gameWidth, halfWidth, halfHeight} = constants;

  const verticalGeometry = new THREE.PlaneGeometry(lineWidth, gameHeight + lineWidth*2);
  const horizontalGeometry = new THREE.PlaneGeometry(gameWidth + lineWidth*2, lineWidth);
  const material = new THREE.MeshBasicMaterial({color: 0xffffff});
  let leftBorder = new THREE.Mesh(verticalGeometry, material);
  let rightBorder = new THREE.Mesh(verticalGeometry, material);
  let topBorder = new THREE.Mesh(horizontalGeometry, material);
  let botBorder = new THREE.Mesh(horizontalGeometry, material);
  borders.add(leftBorder);
  borders.add(rightBorder);
  borders.add(topBorder);
  borders.add(botBorder);

  let verticalOffset = halfWidth + lineWidth/2;
  let horizontalOffset = halfHeight + lineWidth/2;
  leftBorder.position.x = -verticalOffset;
  rightBorder.position.x = verticalOffset;
  topBorder.position.y = horizontalOffset;
  botBorder.position.y = -horizontalOffset;
  return {borders};
})(THREE, scene);

const {lineSegments, heightDifferences} = ((scene, points) => {
  const terrainMeshGroup = new THREE.Group();
  const lineSegments = [];
  const heightDifferences = [];
  
  scene.add(terrainMeshGroup);
  const {halfWidth, halfHeight, lineWidth} = constants;

  function placeTerrainSegment(leftPoint, rightPoint, lineSegments) {
    let leftVector = new THREE.Vector2(leftPoint[0] - halfWidth, leftPoint[1] - halfHeight);
    let rightVector = new THREE.Vector2(rightPoint[0] - halfWidth, rightPoint[1] - halfHeight);
  
    lineSegments.push([leftVector.clone(), rightVector.clone()]);
  
    let center = leftVector.add(rightVector).divideScalar(2);
    let distance = leftVector.distanceTo(rightVector);
  
    const geometry = new THREE.PlaneGeometry(distance*2 + lineWidth/2, lineWidth);
    const material = new THREE.MeshBasicMaterial({color: 0xffffff});
    let terrainMesh = new THREE.Mesh(geometry, material);
    terrainMesh.position.x = center.x;
    terrainMesh.position.y = center.y;
  
    let direction = rightVector.sub(leftVector);
    let angle = direction.angle();
  
    terrainMesh.rotation.z = angle;
    terrainMeshGroup.add(terrainMesh);
  }

  for(let i=0; i<points.length-1; i++) {
    placeTerrainSegment(points[i], points[i+1], lineSegments);
    heightDifferences.push(Math.abs(points[i][1]-points[i+1][1]));
  }
  return {lineSegments, heightDifferences};
})(scene, points);

const {stars} = ((THREE, scene) => {
  // createStars
  let stars = new THREE.Group();
  scene.add(stars);

  const {numOfStars, gameWidth, gameHeight, landerScale} = constants;

  let j;
  for(let i = 0; i < numOfStars; i++) {
    let randomX, randomY;
    randomX = (Math.random() - 0.5) * gameWidth;
    randomY = (Math.random() - 0.5) * gameHeight;

    const geometry = new THREE.PlaneGeometry(landerScale/10, landerScale/5);
    const material = new THREE.MeshBasicMaterial({color: 0xffffff});
    let mesh = new THREE.Mesh(geometry, material);
    stars.add(mesh);

    mesh.position.x = randomX;
    mesh.position.y = randomY;
    mesh.position.z = -5;

    for(j = 0; j < lineSegments.length; j++) {
      let leftVector = lineSegments[j][0];
      let rightVector = lineSegments[j][1];

      if(randomX > leftVector.x && randomX < rightVector.x) {
        if(randomY < Math.max(leftVector.y, rightVector.y)) {
            mesh.visible = false;
        }
        break;
      }
    }
  }
  return {stars};
})(THREE, scene);

const visibleHalfW = Behaviors.select(
  halfHeight * window.innerWidth / window.innerHeight,
  resize, (_prev, _resize) => halfHeight * window.innerWidth / window.innerHeight
);
/*
const isZoomed = Behaviors.select(
  false,
  collisionState, (prev, collisionState) => {
    const isGameOver = gameState.state !== "playOn";
    if (isGameOver) {return false;}
    if(collisionState.altitude <= cameraZoomAltitude || (prev && collisionState.altitude <= cameraZoomOutAltitude)) {
      return true;
    } else if (prev && collisionState.altitude >= cameraZoomOutAltitude) {
      return false;
    }
    return prev;
  }
);
*/

const resizeFunction = (_prev, _resize) => {
  // onWindowResize
  console.log("resizer");

  renderer.setSize(window.innerWidth, window.innerHeight);
  camera.left  = -visibleHalfW;
  camera.right =  visibleHalfW;
  camera.updateProjectionMatrix();
  return {};
};

const resizer = Behaviors.select(
  resizeFunction(),
  resize, resizeFunction
);

const resize = Events.listener(window, "resize", (evt) => evt);
const keydown = Events.listener(window, "keydown", (evt) => evt);
const keyup = Events.listener(window, "keyup", (evt) => evt);
const visibilityChange = Events.listener(document, "visibilitychange", (evt) => evt);

const render = ((scene, renderer, gameState, hudState, shipState, collisionState, camera, resizer) => {
  let trajectory;
  const {isDebugOn} = gameState;
  const {cameraPositionDefault, zoom} = constants;
  if (isDebugOn) {
    trajectory = generateTrajectoryMesh(calculateTrajectory(shipState));
    scene.add(trajectory)
  }

  const {isZoomed, zoomChanged, altitude} = collisionState;
  const z = cameraPositionDefault[2];
  if (isZoomed) {
    camera.position.set(shipState.x, shipState.y - altitude/2, z);
    camera.zoom = zoom;
    camera.updateProjectionMatrix();
  } else if (zoomChanged && isZoomed === false) {
    camera.position.y = 0;
    camera.position.z = z;
    camera.zoom = 1;
    const maxPan = halfWidth - visibleHalfW;
    if (maxPan > 0) {
      // Clamp so neither edge of the viewport exceeds the world boundary
      camera.position.x = Math.max(-maxPan, Math.min(maxPan, lander.position.x));
    } else {
      // Viewport is as wide (or wider) than the world — keep centred
      camera.position.x = 0;
    }   
    camera.updateProjectionMatrix();
  }

  renderer.render(scene, camera);
  renderHud(renderer, gameState, hudState, shipState, collisionState);
  renderRadar(radarCtx, radarCanvas, timer, shipState, collisionState, visibleHalfW);

  if (isDebugOn) {
    scene.remove(trajectory);
  }
})(scene, renderer, gameState, hudState, shipState, collisionState, camera, resizer, timer);

const renderHud = (renderer, gameState, hudState, shipState, collisionState) => {
  const {hudWidth, hudHeight, hudTexture, sceneHud, cameraHud} = hudState;
  hudState.hudContext.clearRect(0, 0, hudWidth, hudHeight);

  fillLeftInfoPanel(gameState, hudState, shipState, collisionState);
  fillRightInfoPanel(gameState, hudState, shipState, collisionState);
  fillMainPanel(gameState, hudState, shipState, collisionState);

  drawMultipliers(gameState, hudState);

  hudTexture.needsUpdate = true;
  renderer.render(sceneHud, cameraHud);
}

function calculateTrajectory(shipState) {
  const {x, y, velocityX, velocityY} = shipState;
  const {halfHeight, horizontalDragCoef, gravity} = constants;
  let x0 = x; // lander.position.x;
  let y0 = y; // lander.position.y;
  let tAx = 0;
  let tAy = -gravity;
  let tVx = velocityX;
  let tVy = velocityY;
  const dt = 1.0/60;

  let res = [[x0,y0]];

  while (y0 > -halfHeight) {
    tAx = -tVx * horizontalDragCoef;

    tVx += tAx * dt;
    tVy += tAy * dt;

    const x1 = x0 + tVx*dt;
    const y1 = y0 + tVy*dt;

    res.push([x1,y1]);

    x0 = x1;
    y0 = y1;
  }

  return res;
}

function generateTrajectoryMesh(trajectory) {
  const lineMeshes = new THREE.Group();
  const {lineWidth} = constants;

  const material = new THREE.MeshBasicMaterial({color: 0xffffff});
  const geometry = new THREE.PlaneGeometry(1, 1);

  for (let i = 0; i < trajectory.length-1; i++) {
    const point0 = trajectory[i];
    const point1 = trajectory[i+1];

    const deltaX = point1[0]-point0[0];
    const deltaY = point1[1]-point0[1];

    const middle = [(point0[0] + point1[0])/2, (point0[1] + point1[1])/2];
    const scale = Math.sqrt(Math.pow(deltaX, 2) + Math.pow(deltaY, 2));
    const angle = Math.atan2(deltaY, deltaX);

    const lineMesh = new THREE.Mesh(geometry, material);

    lineMesh.scale.x = scale;
    lineMesh.scale.y = lineWidth;

    lineMesh.position.x = middle[0];
    lineMesh.position.y = middle[1];

    lineMesh.rotation.z = angle;

    lineMeshes.add(lineMesh);
  }
    
  return lineMeshes;
}

const randomSpawn = () => {
  let randomPositionX;
  let randomPositionY;
  let randomRotation;
  const {
    halfWidth, halfHeight, horizontalSpawnOffset,
    middleSpawnOffset, verticalMiddleSpawnOffset,
    velocityXSpawnMax, velocityXSpawnMin} = constants;
  let minX = -halfWidth + horizontalSpawnOffset;
  let maxX = halfWidth - horizontalSpawnOffset;

  if(Math.random() > 0.5) {
    minX = -halfWidth + horizontalSpawnOffset;
    maxX = -middleSpawnOffset;
  } else {
    minX = middleSpawnOffset;
    maxX = halfWidth - horizontalSpawnOffset;
  }

  randomPositionX = Math.random() * (maxX - minX) + minX;

  const minY = verticalMiddleSpawnOffset;
  const maxY = halfHeight - verticalTopSpawnOffset;

  randomPositionY = Math.random() * (maxY - minY) + minY;
  randomRotation = (Math.random() - 0.5) * Math.PI; 

  let initialVelocity = Math.random() * (velocityXSpawnMax - velocityXSpawnMin) + velocityXSpawnMin;
  if(randomPositionX > 0) {
    initialVelocity = -initialVelocity;
  }
  return {initialVelocity, randomPositionX, randomPositionY, randomRotation};
}


const updateLander = ((lander, shipState) => {
  lander.position.x = shipState.x;
  lander.position.y = shipState.y;
  lander.rotation.z = shipState.r;
})(lander, shipState);`],
[`13`, `const isAlerted = Behaviors.select(
  false,
  shipState, (prev, currentFuel) => {
    if (!prev && shipState.currentFuel < fuelAlertThreshold) {
      fuelAlert();
      return true;
    }
    if (prev && shipState.currentFuel > fuelAlertThreshold) {
      return false;
    }
    return prev;
  }
);

const fuelAlert = ((gameState, shipState, timer) => {
  if (gameState.isGameOver || shipState.isAlerted) {
    // lowFuelSound.play();
  }
})(gameState, shipState, timer);
/*
const crashSound = new sound("audio/crash.mp3");
const rocketSound = new sound("audio/rocket.mp3");
const lowFuelSound = new sound("audio/alarm.mp3");
const commSound = new sound("audio/morse.mp3");
