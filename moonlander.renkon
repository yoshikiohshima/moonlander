[`160`, `const controlState = Behaviors.select(
  {rotatingRight: false, rotatingLeft: false, accelerating: false, viewId},
  keys, (prev, keys) => {
    const value = {...prev};
    if (keys.includes("ArrowLeftDown")) {
      value.rotatingLeft = true;
    }
    if (keys.includes("ArrowRightDown")) {
      value.rotatingRight = true;
    }
    if (keys.includes("ArrowUpDown")) {
      value.accelerating = true;
    }
    if (keys.includes("ArrowLeftUp")) {
      value.rotatingLeft = false;
    }
    if (keys.includes("ArrowRightUp")) {
      value.rotatingRight = false;
    }
    if (keys.includes("ArrowUpUp")) {
      value.accelerating = false;
    }
    if (prev.rotatingLeft === value.rotatingLeft &&
      prev.rotatingRight === value.rotatingRight &&
      prev.accelerating === value.accelerating) {
      return prev;
    }
    return value;
  },
);

const keyLeftDown = Events.listener(
  document.body, "keydown", 
  (evt) => evt.key === "ArrowLeft" ? evt.key + "Down" : undefined
);

const keyRightDown = Events.listener(
  document.body, "keydown",
  (evt) => evt.key === "ArrowRight" ? evt.key + "Down" : undefined
);

const keyUpDown = Events.listener(
  document.body, "keydown",
  (evt) => evt.key === "ArrowUp" ? evt.key + "Down" : undefined
);

const keyLeftUp = Events.listener(
  document.body, "keyup", 
  (evt) => evt.key === "ArrowLeft" ? evt.key + "Up" : undefined
);

const keyRightUp = Events.listener(
  document.body, "keyup",
  (evt) => evt.key === "ArrowRight" ? evt.key + "Up" : undefined
);

const keyUpUp = Events.listener(
  document.body, "keyup",
  (evt) => evt.key === "ArrowUp" ? evt.key + "Up": undefined
);

const keys = Events.some(keyLeftDown, keyRightDown, keyUpDown, keyLeftUp, keyRightUp, keyUpUp);
`],
[`196`, `const viewId = Renkon.app?.viewId || "local";
const isLocal = viewId === "local";

const viewExit = Events.receiver({queued: true});
const viewJoin = Events.receiver({queued: true});

const colors = ["red", "blue", "green", "yellow"];

const players = Behaviors.select(
  {map: (isLocal ? new Map([[viewId, {color: colors[0]}]]) : new Map)},
  viewJoin, (prev, joins) => {
    for (const join of joins) {
      prev.map.set(join, {color: colors[prev.map.size % colors.length]});
    }
    return {map: prev.map};
  },
  viewExit, (prev, exits) => {
    for (const exit of exits) {
      prev.delete(exit);
    }
    return {map: prev.map};
  }
);

console.log("players", players)`],
[`197`, `const newShipState = (viewId, isOngoing) => {
  const obj = {
    x: 0, y: 0, r: 0, visible: true,
    velocityDeltaX: 0, velocityDeltaY: 0,
    currentAcceleration: 0, currentAccelerationRatio: 0,
    currentFuel: 1000,
    landerForward: new THREE.Vector2(0,1),
    landerBackDirection: new THREE.Vector2(0,1),
    velocityX: 0, velocityY: 0,
    time: -1, viewId
  };
  if (isOngoing) {
    const {initialVelocity, randomPositionX, randomPositionY, randomRotation} = randomSpawn();
    return {...obj, x: randomPositionX, y: randomPositionY, r: randomRotation, velocityX: initialVelocity, velocityY: 0, time: Renkon.now};
  }
  return obj;
};

const shipStates = Behaviors.select(
  isLocal ? {map: new Map([[viewId, newShipState(viewId)]]) }: new Map(),
  players, (prev, players) => {
    const prevKeys = [...prev.map.keys()];
    const newKeys = [...players.map.keys()];
    const olds = prevKeys.filter((e) => !newKeys.includes(e));
    const news = newKeys.filter((e) => !prevKeys.includes(e));
    olds.forEach((id) => prev.map.delete(id));
    news.forEach((id) => {
      prev.map.set(id, newShipState(id, (gameState.state === "playOn")));
    });
    return {map: prev.map}
  },
  newRound, (prev, _new) => {
    console.log("new ship(s)");
    return {map: new Map(
      [...prev.map].map(([viewId, ship]) => ([viewId, newShipState(viewId)]))
    )};
  },
  gameState, (prev, gameState) => {
    if (gameState.state === "playOn") {
      console.log('play');
      for (const [viewId, ship] of prev.map) {
        const {initialVelocity, randomPositionX, randomPositionY, randomRotation} = randomSpawn();
        prev.map.set(viewId, {...ship, x: randomPositionX, y: randomPositionY, r: randomRotation, velocityX: initialVelocity, velocityY: 0, time: Renkon.now})
      };
      return {map: prev.map};
    }
    return prev;
  },
  timerState, (prevShips, timer) => {
    const prev = prevShips.map.get(viewId);
    let rotationDelta = 0;
    if (gameState.state === "showWinner") {return prevShips;}
    
    const deltaTime = timer.delta;
    const time = timer.now;
    let {x, y, r, landerForward} = prev;
    const {rotatingRight, rotatingLeft, accelerating} = controlStates.map.get(viewId);
    const {
      angularVelocity, thrusterJerk, thrusterAccelerationMax, gravity,
      fuelConsumptionRateMax, fuelConsumptionRateMin,
      accelerationFalloffMultiplier, horizontalDragCoef} = constants;
    
    if(rotatingLeft) rotationDelta += angularVelocity * deltaTime;
    if(rotatingRight) rotationDelta += -angularVelocity * deltaTime;

    r += rotationDelta;
    // console.log(r)

    if(r > Math.PI / 2) r = Math.PI / 2;
    if(r < -Math.PI / 2) r = -Math.PI / 2;
    
    let velocityDeltaY = 0;
    let velocityDeltaX = 0;

    velocityDeltaY += -gravity * deltaTime;
    let currentAcceleration = prev.currentAcceleration;
    let currentAccelerationRatio = prev.currentAccelerationRatio;
    let currentFuel = prev.currentFuel;
    let velocityX = prev.velocityX;
    let velocityY = prev.velocityY;

    if(accelerating && currentFuel > 0) {
      rocketSound.play();

      currentAcceleration += thrusterJerk * deltaTime;
      if(currentAcceleration > thrusterAccelerationMax) currentAcceleration = thrusterAccelerationMax;

      currentAccelerationRatio = currentAcceleration / thrusterAccelerationMax;
      let fuelBurned = currentAccelerationRatio * (fuelConsumptionRateMax - fuelConsumptionRateMin) + fuelConsumptionRateMin;
      currentFuel -= fuelBurned * deltaTime;
      if (currentFuel < 0.0001) currentFuel = 0;
      // fuelCheck();
      // fuelAlertCheck();
     // console.log(currentAcceleration);
    } else {
      rocketSound.stop();

      currentAcceleration -= thrusterJerk * deltaTime * accelerationFalloffMultiplier;
      if(currentAcceleration < 0) currentAcceleration = 0;
    }

    landerForward.x = 0;
    landerForward.y = 1;
    const vector2Zero = new THREE.Vector2(0,0);
    landerForward.rotateAround(vector2Zero, r);
    prev.landerBackDirection.x = -landerForward.x;
    prev.landerBackDirection.y = -landerForward.y;

    velocityDeltaX += -velocityX * horizontalDragCoef * deltaTime;

    velocityDeltaX += landerForward.x * currentAcceleration * deltaTime;
    velocityDeltaY += landerForward.y * currentAcceleration * deltaTime;

    velocityY += velocityDeltaY;
    velocityX += velocityDeltaX;

    // console.log(velocityX, velocityY);
  
    let positionDeltaY = velocityY * deltaTime
    // lander.position.y += positionDeltaY;
    y += positionDeltaY;

    let positionDeltaX = velocityX * deltaTime;
    // lander.position.x += positionDeltaX;
    x += positionDeltaX;
    prevShips.map.set(viewId, {
      x, y, r, visible: prev.visible,
      velocityDeltaX, velocityDeltaY,
      currentAcceleration, currentFuel, currentAccelerationRatio,
      landerForward, landerBackDirection: prev.landerBackDirection,
      velocityX, velocityY, time
    });
    return {map: prevShips.map}
  }
);

const colliderPositions = (() => {
  const {mainScale, smallScale} = constants;
  const verticalOffset = -mainScale + smallScale;
  const horizontalOffset = mainScale - smallScale;
  return [{
    name: "left", 
    position: {x: -horizontalOffset, y: verticalOffset},
    radius: smallScale
  }, 
  {
    name: "right",
    position: {x: horizontalOffset, y: verticalOffset},
    radius: smallScale
  },
  {
    name: "main",
    position: {x: 0, y: 0},
    radius: mainScale          
  }
]
})();
console.log("col", colliderPositions)

function newLander() {
  const {mainScale, smallScale} = constants;
  const geometry = new THREE.PlaneGeometry(constants.landerScale, constants.landerScale);
  const texture = new THREE.TextureLoader().load('textures/lander.png');
  const material = new THREE.MeshBasicMaterial({map: texture});
  material.transparent = true;
  const lander = new THREE.Mesh(geometry, material);
  scene.add(lander);

  return lander;
}

const landers = Behaviors.select(
  isLocal ? {map: new Map([[viewId, newLander()]])}: new Map(),
  viewJoin, (prev, joins) => {
    for (const join of joins) {
      const lander = newLander();
      prev.map.set(viewId, lander);
    }
    return {map: prev.map};
  },
  viewExit, (prev, exits) => {
    for (const exit of exits) {
      prev.delete(exit);
    }
    return {map: prev.map};
  },
)`]]}