  },
  players, (prev, players) => {
    const prevKeys = [...prev.map.keys()];
    const olds = prevKeys.filter((e) => !players.map.get(e));
    olds.forEach((id) => prev.map.delete(id));
    if (olds.length === 0) return prev;
    return {map: prev.map};
  }
);`],
[`160`, `const controlState = Behaviors.select(
  {rotatingRight: false, rotatingLeft: false, accelerating: false,
   wasThrustingFromButton: false, wasRotatingFromJoystick: false, viewId},
  keys, (prev, keys) => {
    const value = {...prev};
    if (keys.includes("ArrowLeftDown")) {
      value.rotatingLeft = true;
    }
    if (keys.includes("ArrowRightDown")) {
      value.rotatingRight = true;
    }
    if (keys.includes("ArrowUpDown")) {
      value.accelerating = true;
    }
    if (keys.includes("ArrowLeftUp")) {
      value.rotatingLeft = false;
    }
    if (keys.includes("ArrowRightUp")) {
      value.rotatingRight = false;
    }
    if (keys.includes("ArrowUpUp")) {
      value.accelerating = false;
    }
    const joystick = keys.find(x => x?.joystick);
    if (joystick !== undefined) {
      if (joystick.rotatingLeft || joystick.rotatingRight) {
        // console.log("joystickRotating");
        value.wasRotatingFromJoystick = true;
        if (joystick.rotatingLeft) {
          value.rotatingLeft = true;
        }
        if (joystick.rotatingRight) {
          value.rotatingRight = true;
        }
      }
      if (!joystick.rotatingLeft && !joystick.rotatingRight) {
        if (prev.wasRotatingFromJoystick) {
          // console.log("not joystickRotating");
          value.rotatingLeft = false;
          value.rotatingRight = false;
          value.wasRotatingFromJoystick = false;
        }
      }
    }
    const thruster = keys.find(x => x?.thruster);
    if (thruster !== undefined) {
      if (thruster.accelerating) {
        value.wasThrustingFromButton = true;
        value.accelerating = true;
      } else if (value.wasThrustingFromButton && !thruster.accelerating) {
        value.wasThrustingFromButton = false;
        value.accelerating = false;
      }
    }

    if (prev.rotatingLeft === value.rotatingLeft &&
      prev.rotatingRight === value.rotatingRight &&
      prev.accelerating === value.accelerating &&
      prev.wasRotatingFromJoystick === value.wasRotatingFromJoystick) {
      return prev;
    }
    // console.log("change", value);
    return value;
  },
);

