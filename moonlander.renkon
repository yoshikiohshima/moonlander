 explosionPSParticlesMax, explosionPSLifetimeMin, explosionPSLifetimeMax, explosionPSDragCoefMin, explosionPSDragCoefMax, explosionPSSize, explosionPSMinVelocityMagnitude, explosionPSMaxVelocityMagnitude, explosionPSOpacityStart, explosionPSOpacityEnd, explosionPSColorStart, explosionPSColorEnd, explosionPSScaleStart, explosionPSScaleEnd,

 RADAR_W, RADAR_H,
